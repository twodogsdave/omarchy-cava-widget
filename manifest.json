{
  "schemaVersion": 1,
  "id": "my.cava",
  "name": "Cava",
  "version": "1.3.0",
  "author": "Dave Brown",
  "license": "MIT",
  "description": "Audio visualizer bars for the Omarchy status bar, painted in the bar text color.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Cava",
    "description": "Cava audio visualizer. Click to change bars, width, and gap.",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "bars": 10,
      "barWidth": 3,
      "gap": 2,
      "framerate": 30
    },
    "schema": [
      {
        "key": "bars",
        "type": "integer",
        "label": "Bars",
        "min": 4,
        "max": 64,
        "step": 1,
        "defaultValue": 10,
        "description": "Number of frequency bars."
      },
      {
        "key": "barWidth",
        "type": "integer",
        "label": "Bar width",
        "min": 1,
        "max": 8,
        "step": 1,
        "defaultValue": 3,
        "description": "Thickness of each bar in pixels."
      },
      {
        "key": "gap",
        "type": "integer",
        "label": "Gap",
        "min": 0,
        "max": 8,
        "step": 1,
        "defaultValue": 2,
        "description": "Space between bars in pixels."
      },
      {
        "key": "framerate",
        "type": "integer",
        "label": "Framerate",
        "min": 10,
        "max": 60,
        "step": 5,
        "defaultValue": 30,
        "description": "Cava sample rate in frames per second."
      }
    ]
  }
}
